; Synkcut - Bahasa Indonesia Custom NSIS Strings (Modern & Natural)

; Override built-in 2009 NSIS MUI strings with clean, friendly modern Indonesian copy
LangString MUI_TEXT_WELCOME_INFO_TITLE ${LANG_INDONESIAN} "Selamat datang di Synkcut"
LangString MUI_TEXT_WELCOME_INFO_TEXT ${LANG_INDONESIAN} "Suara, footage, dan AI Motion otomatis sinkron dalam hitungan menit.$\r$\n$\r$\nWizard ini akan memasang ${PRODUCTNAME} ${VERSION} secara lokal di perangkat kamu - tanpa watermark dan tanpa sistem kuota kredit.$\r$\n$\r$\nKlik Lanjut > untuk mulai memasang."
LangString MUI_TEXT_DIRECTORY_TITLE ${LANG_INDONESIAN} "Folder Instalasi"
LangString MUI_TEXT_DIRECTORY_SUBTITLE ${LANG_INDONESIAN} "Pilih lokasi folder untuk memasang ${PRODUCTNAME}."
LangString MUI_TEXT_INSTALLING_TITLE ${LANG_INDONESIAN} "Memasang ${PRODUCTNAME}"
LangString MUI_TEXT_INSTALLING_SUBTITLE ${LANG_INDONESIAN} "Tunggu sebentar, file studio ${PRODUCTNAME} sedang disiapkan..."
LangString MUI_TEXT_FINISH_TITLE ${LANG_INDONESIAN} "Instalasi Selesai"
LangString MUI_TEXT_FINISH_SUBTITLE ${LANG_INDONESIAN} "${PRODUCTNAME} berhasil dipasang dengan sempurna."
LangString MUI_TEXT_ABORT_TITLE ${LANG_INDONESIAN} "Instalasi Dibatalkan"
LangString MUI_TEXT_ABORT_SUBTITLE ${LANG_INDONESIAN} "Proses instalasi dihentikan sebelum selesai."
LangString MUI_TEXT_FINISH_INFO_TITLE ${LANG_INDONESIAN} "${PRODUCTNAME} Siap Dipakai!"
LangString MUI_TEXT_FINISH_INFO_TEXT ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terpasang di perangkat kamu.$\r$\n$\r$\nKlik Selesai untuk menutup wizard dan langsung mulai bikin video."
LangString MUI_TEXT_FINISH_RUN ${LANG_INDONESIAN} "&Buka ${PRODUCTNAME} sekarang"
LangString MUI_BUTTONTEXT_FINISH ${LANG_INDONESIAN} "&Selesai"
LangString MUI_TEXT_ABORTWARNING ${LANG_INDONESIAN} "Yakin ingin membatalkan instalasi ${PRODUCTNAME}?"

; Uninstaller MUI overrides (clean modern Indonesian)
LangString MUI_UNTEXT_CONFIRM_TITLE ${LANG_INDONESIAN} "Hapus ${PRODUCTNAME}"
LangString MUI_UNTEXT_CONFIRM_SUBTITLE ${LANG_INDONESIAN} "Hapus instalasi ${PRODUCTNAME} dari perangkat kamu."
LangString MUI_UNTEXT_UNINSTALLING_TITLE ${LANG_INDONESIAN} "Menghapus ${PRODUCTNAME}"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE ${LANG_INDONESIAN} "Tunggu sebentar, file aplikasi sedang dihapus..."
LangString MUI_UNTEXT_FINISH_TITLE ${LANG_INDONESIAN} "Penghapusan Selesai"
LangString MUI_UNTEXT_FINISH_SUBTITLE ${LANG_INDONESIAN} "${PRODUCTNAME} sudah dihapus dari perangkat kamu."
LangString MUI_UNTEXT_ABORT_TITLE ${LANG_INDONESIAN} "Penghapusan Dibatalkan"
LangString MUI_UNTEXT_ABORT_SUBTITLE ${LANG_INDONESIAN} "Penghapusan dihentikan sebelum selesai."
LangString MUI_UNTEXT_ABORTWARNING ${LANG_INDONESIAN} "Yakin ingin membatalkan penghapusan ${PRODUCTNAME}?"

; Tauri v2 Custom Installer Strings (Indonesian)
LangString addOrReinstall ${LANG_INDONESIAN} "Pasang ulang / perbaiki aplikasi"
LangString alreadyInstalled ${LANG_INDONESIAN} "Sudah Terpasang"
LangString alreadyInstalledLong ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terpasang di perangkat ini. Pilih tindakan yang ingin dilakukan lalu klik Lanjut >."
LangString appRunning ${LANG_INDONESIAN} "{{product_name}} sedang berjalan! Tutup aplikasinya terlebih dahulu lalu coba lagi."
LangString noPermissionToCloseApp ${LANG_INDONESIAN} "Tidak cukup izin untuk menutup {{product_name}}. Tutup aplikasinya secara manual lalu coba lagi."
LangString appRunningOkKill ${LANG_INDONESIAN} "{{product_name}} sedang terbuka!$\nKlik OK untuk menutupnya otomatis."
LangString chooseMaintenanceOption ${LANG_INDONESIAN} "Pilih tindakan pemeliharaan yang diinginkan."
LangString chooseHowToInstall ${LANG_INDONESIAN} "Pilih cara memperbarui ${PRODUCTNAME}."
LangString createDesktop ${LANG_INDONESIAN} "Buat shortcut ${PRODUCTNAME} di Desktop"
LangString dontUninstall ${LANG_INDONESIAN} "Langsung perbarui tanpa menghapus versi lama"
LangString dontUninstallDowngrade ${LANG_INDONESIAN} "Langsung timpa (downgrade tanpa uninstall dinonaktifkan)"
LangString failedToKillApp ${LANG_INDONESIAN} "Gagal menutup {{product_name}}. Tutup aplikasinya secara manual lalu coba lagi."
LangString installingWebview2 ${LANG_INDONESIAN} "Memasang Microsoft WebView2 Runtime..."
LangString newerVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang lebih baru sudah terpasang. Disarankan menghapus versi lama terlebih dahulu sebelum melanjutkan."
LangString older ${LANG_INDONESIAN} "lama"
LangString olderOrUnknownVersionInstalled ${LANG_INDONESIAN} "Versi $R4 dari ${PRODUCTNAME} terdeteksi di perangkat kamu. Pilih cara pembaruan lalu klik Lanjut >."
LangString silentDowngrades ${LANG_INDONESIAN} "Downgrade otomatis dinonaktifkan. Gunakan installer grafis untuk mengganti versi.$\n"
LangString unableToUninstall ${LANG_INDONESIAN} "Gagal menghapus versi sebelumnya!"
LangString uninstallApp ${LANG_INDONESIAN} "Hapus (Uninstall) ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_INDONESIAN} "Hapus versi lama dulu, lalu pasang versi baru (Disarankan)"
LangString unknown ${LANG_INDONESIAN} "tidak dikenal"
LangString webview2AbortError ${LANG_INDONESIAN} "Gagal memasang WebView2! Aplikasi membutuhkan komponen ini. Coba jalankan ulang installer."
LangString webview2DownloadError ${LANG_INDONESIAN} "Gagal mengunduh WebView2 Runtime - $0"
LangString webview2DownloadSuccess ${LANG_INDONESIAN} "WebView2 Runtime berhasil diunduh"
LangString webview2Downloading ${LANG_INDONESIAN} "Mengunduh Microsoft WebView2 Runtime..."
LangString webview2InstallError ${LANG_INDONESIAN} "Gagal memasang WebView2 Runtime (kode $1)"
LangString webview2InstallSuccess ${LANG_INDONESIAN} "WebView2 Runtime berhasil dipasang"
LangString deleteAppData ${LANG_INDONESIAN} "Hapus juga data pengaturan & proyek lokal Synkcut"
