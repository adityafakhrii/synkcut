{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synkcut",
  "version": "1.2.0",
  "identifier": "id.synkcut.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Synkcut — AI Video Editor",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Synkcut Studio",
    "category": "Video",
    "shortDescription": "AI Desktop Video Editor — Suara, footage, dan motion otomatis sinkron.",
    "longDescription": "Synkcut adalah aplikasi desktop AI Video Editor ringan untuk Content Creator dan UMKM memproduksi video pendek 9:16 secara lokal tanpa watermark dan tanpa sistem kuota kredit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
